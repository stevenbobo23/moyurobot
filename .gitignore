# 自动打招呼的检测模型（本地放置，别入库：约 6~12MB 的二进制）
pi_client/models/*.onnx
pi_client/models/*.pt

# 自动打招呼的本地语音池：TTS 生成物或自己录的 wav，属本机资产（体积 + 个人录音），
# 换机器时用脚本重新生成，或手动 scp 过去
pi_client/assets/greetings/*.wav
pi_client/assets/greetings/manifest.json

# 自签 HTTPS 证书：含私钥，且按各机 IP 签发（换机/换网段要重签），不入库。
# 每台机器跑 ./scripts/gen_self_signed_cert.sh <本机IP> 自行生成。
pi_client/certs/

