# ============================================
# 摸鱼遥控车 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================

# === 机器人配置 ===
ROBOT_ID=my_awesome_kiwi

# === Web 服务配置 ===
WEB_HOST=0.0.0.0
WEB_PORT=8080
FLASK_SECRET_KEY=your-secure-secret-key-here-change-me

# === MCP 服务配置 ===
MCP_MODE=http
MCP_PORT=8000

# === 推流配置 ===
STREAMING_ENABLED=false
RTMP_STREAM_URL=rtmp://your-stream-server.com/live/stream-key
STREAM_ROTATE_180=false

# === 小智 AI MCP 管道配置 ===
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=your-token-here
MCP_CONFIG=/path/to/mcp_config.json

# === 阿里云千问 VL API ===
QWEN_API_KEY=sk-your-qwen-api-key-here

# === 会话超时配置（秒）===
SESSION_TIMEOUT_SECONDS=100
VIP_SESSION_TIMEOUT_SECONDS=600

# === 会话 Cookie ===
# 网页与音频用了不同域名时（网页 lerobot.mycodebro.cn、音频 lerobotwws.mycodebro.cn），
# 语音对讲已改用「连接令牌」证明身份（见下面的 AUDIO_TOKEN_*），**不再依赖跨域 Cookie**，
# 所以这项一般是留空的。
# 只有当页面是缓存里的旧 JS（不带令牌）时才需要它兜底：填父域让 Cookie 跨子域共享，
# 例如 .mycodebro.cn
# ⚠️ 用 IP / localhost 直连访问时务必留空，否则浏览器会直接丢弃 Cookie
SESSION_COOKIE_DOMAIN=
# TLS 终止在反代（nginx）上时置 1：Flask 看到的是 http，需要手动让 Cookie 带 Secure
SESSION_COOKIE_SECURE=

# === 语音对讲配置 ===
# 需要声卡：sudo apt install -y alsa-utils
AUDIO_ENABLED=true
# auto | alsa | pulse | ffmpeg | sim（sim = 无硬件模拟后端）
AUDIO_BACKEND=auto
# 留空 = 系统默认设备；也可写 plughw:1,0 这样的 ALSA 设备号
AUDIO_CAPTURE_DEVICE=
AUDIO_PLAYBACK_DEVICE=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=100
# 软件增益（1.0 = 原音量；麦克风太小可调到 2~4）
AUDIO_MONITOR_GAIN=1.0
AUDIO_TALK_GAIN=1.0
# 语音对讲 WebSocket 端口（与网页 8080 分开）
AUDIO_WS_PORT=8081
AUDIO_WS_HOST=0.0.0.0
# 浏览器实际连接的 ws 地址（反代/内网穿透/多域名场景必填）
# 留空 = 用 config/default.json 里配的值；写 auto / none / - = 强制按当前访问地址推导
# 写法很宽松：写 https://lerobotwws.mycodebro.cn/ 会自动变成 wss://lerobotwws.mycodebro.cn/audio
#            只写域名会自动补 /audio，且不会自作主张加 :8081（前面是反代就是 443/80）
AUDIO_WS_PUBLIC_URL=
AUDIO_MAX_CLIENTS=8

# === 语音对讲：连接令牌 ===
# 网页登录后会把身份签成令牌拼进 ws 地址（wss://.../audio?token=xxx），音频服务独立验签。
# 这是跨域名场景下唯一的身份凭据 —— 会话 Cookie 属于网页域名，浏览器不会把它带到
# 音频域名的 WebSocket 握手上，以前因此一直提示「未登录」。
# 签发和校验都在同一个进程里，所以**默认无需配置**。只有把音频服务单独拆成另一个
# 进程/容器部署时，才必须两端配同一个密钥。
AUDIO_TOKEN_SECRET=
# 令牌有效期（秒），默认 21600 = 6 小时；页面上连不上时会自动换新令牌
AUDIO_TOKEN_TTL=21600

# === 日志治理（防止 lerobot 摄像头刷屏写满磁盘）===
# 根日志级别
LOG_LEVEL=INFO
# 噪声 logger 的级别；摄像头刷屏时可以设成 ERROR 直接静音
# 默认列表见 moyurobot/logging_setup.py 的 DEFAULT_NOISY_LOGGERS
LOG_NOISY_LEVEL=WARNING
# 同一消息的初始抑制窗口（秒），0 = 关闭去重；之后按 1s→2s→4s… 指数退避重报
LOG_DEDUP_WINDOW_S=1.0
LOG_DEDUP_MAX_WINDOW_S=300
# 单个 logger 每秒最多放行多少条，0 = 关闭限速
LOG_RATE_LIMIT_PER_S=20
# 是否额外写日志文件（不设时：配置了 LOG_DIR 就自动开启）
LOG_TO_FILE=0
LOG_DIR=/home/bobo/logs
LOG_FILE=moyurobot.log
# 单文件上限与滚动备份数量（5MB × 4 = 最多 20MB）
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# === 摄像头 ===
# 设备文件不存在时跳过该摄像头，避免 lerobot 按采集帧率反复重试刷屏
# 设为 0 可恢复"照常交给 lerobot 自己重试"的旧行为
CAMERA_SKIP_MISSING=1

# === 自动打招呼（有人进入视野 → 说话 + 点头）===
# 总开关；false 时线程仍会起来，只是不动作，网页上可随时打开
GREETING_ENABLED=1
# 用哪路摄像头（front = 车头那个）
GREETING_CAMERA=front
# 检测器：auto = 有 onnxruntime+模型就用 YOLO，否则退回 OpenCV HOG；也可强制 yolo/hog/none
GREETING_DETECTOR=auto
# ONNX 模型路径（留空自动找 models/yolo11n.onnx）
GREETING_MODEL_PATH=
# 每秒检测多少次。Pi 4 建议 2~3，Pi 5 可以 4~6
GREETING_DETECT_FPS=4
# 模型输入尺寸，越小越快、越远的人越难检出
GREETING_INPUT_SIZE=320
# 触发门槛：bbox 高度占画面高度的比例（≈ 1.62 / 距离米数）
# 0.30 ≈ 5.4 米内；0.45 ≈ 3.6 米内。对着帐篷门口建议 0.30，对着通道建议 0.45
GREETING_MIN_PERSON_RATIO=0.30
# 人必须落在画面中央多大比例内（1.0 = 不限制）
GREETING_CENTER_ZONE=0.7
# 连击门槛：累积分（命中 +1、漏检 -0.5）达到多少才触发；默认 3 ≈ 容忍一次漏检
GREETING_TRIGGER_FRAMES=3
# 且至少持续这么久（秒），防止一闪而过
GREETING_TRIGGER_SECONDS=0.5
# 连续多久没人算「离开」（秒），离开后才允许下一次触发
GREETING_LEAVE_SECONDS=8
# 同一个场景的冷却时间（秒），默认 3 分钟
GREETING_COOLDOWN_SECONDS=180
# 每小时最多招呼几次（兜底，防止营地人多时变广播）
GREETING_MAX_PER_HOUR=6
# 允许打招呼的时段（本地时间，跨零点写成 22:00-06:00；留空=全天）
GREETING_ACTIVE_HOURS=08:00-22:00
# 动作：nod（点头）/ shake_head（摇头）/ none（只说话）
GREETING_GESTURE=nod
# 说话之后隔多久开始动（毫秒），别和语音抢拍
GREETING_GESTURE_DELAY_MS=600
# 对讲中不插话（会等 intercom_wait_s 秒，还占用就放弃本次语音）
GREETING_RESPECT_INTERCOM=1
GREETING_INTERCOM_WAIT_S=3
# 有人正在操作机械臂时只出声不动手（play() 会打断别人的动作）
GREETING_RESPECT_ARM_BUSY=1
# 打招呼瞬间存一张 jpg 用于调试；留空 = 不落盘（营地是半公共场所，默认不存）
GREETING_SNAPSHOT_DIR=

# --- 语音 ---
# auto = 先找本地音频池，没有就用云端 TTS；也可固定 pool / tts / off
GREETING_SPEECH_MODE=auto
# 本地音频池目录（配合 scripts/gen_greeting_voices.py 生成）
GREETING_AUDIO_DIR=assets/greetings
# TTS 音色与模型（DashScope；longxiaochun=龙小淳，qwen-tts 会自动换成 Cherry）
GREETING_TTS_VOICE=longxiaochun
GREETING_TTS_MODEL=cosyvoice-v1
# 单句合成超时（秒）；超时/失败会退回本地音频池
GREETING_TIMEOUT_S=8
# 打招呼音量（相对对讲），比对讲低一档，不该像广播
GREETING_GAIN=0.8
# 文案池，逗号分隔（本地音频池为空时用它合成）
GREETING_TEXTS=

